{
  "rewrites": [
    { "source": "/", "destination": "/bake-factory-website/index.html" },
    { "source": "/pages/:path*", "destination": "/bake-factory-website/pages/:path*" },
    { "source": "/css/:path*", "destination": "/bake-factory-website/css/:path*" },
    { "source": "/js/:path*", "destination": "/bake-factory-website/js/:path*" },
    { "source": "/data/:path*", "destination": "/bake-factory-website/data/:path*" },
    { "source": "/assets/:path*", "destination": "/bake-factory-website/assets/:path*" }
  ]
}
